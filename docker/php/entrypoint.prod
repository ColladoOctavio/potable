#!/usr/bin/env sh
set -e

if [ "${1#-}" != "$1" ]; then
    set -- php-fpm "$@"
fi

mkdir -p storage/app/public storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache
chown -R www-data:www-data storage bootstrap/cache

run_as_app_user() {
    if [ "$(id -u)" = "0" ]; then
        gosu www-data "$@"
    else
        "$@"
    fi
}

if [ "${POTABLE_OPTIMIZE_ON_BOOT:-true}" = "true" ]; then
    run_as_app_user php artisan optimize:clear --no-interaction
    run_as_app_user php artisan config:cache --no-interaction
    run_as_app_user php artisan route:cache --no-interaction
    run_as_app_user php artisan view:cache --no-interaction
fi

if [ "$1" = "php-fpm" ]; then
    exec "$@"
fi

if [ "$(id -u)" = "0" ]; then
    exec gosu www-data "$@"
fi

exec "$@"
